# PostgreSQL connection string (required)
DATABASE_URL="postgresql://user:password@localhost:5432/jobflow"

# Session signing secret (required) — generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-me-with-a-random-secret"

# Public URL of this deployment (required in production)
# NEXTAUTH_URL="https://your-domain.example.com"

# Google OAuth (optional — Google sign-in stays disabled when unset)
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# OpenAI (optional — the AI task planner reports a configuration error when unset)
# OPENAI_API_KEY=""
# Optional model override (defaults to gpt-4o-mini)
# OPENAI_MODEL=""
# Optional request timeout in milliseconds (defaults to 30000)
# OPENAI_TIMEOUT_MS=""
